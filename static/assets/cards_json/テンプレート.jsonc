  /*
  --------------------------------------------- */
  /* 凡例 */
  {
    // カードID
    "cardID": "カードID",
    // 商品ID
    "productID": "商品ID",
    // カード画像
    "image": "public/assets/cards_img/商品ID/カードID.webp",
    // カード名
    "name": "凡例の巫女 タマヨリヒメ",
    // 検索用の平仮名ワード
    "subName": [
      // 読み
      "はんれいのみこたまよりひめ",
      // 略称
      "はんたま",
      "はんれいたま"
    ],
    // レアリティ（C,R,SR,LR）
    "rarity": "",
    // イラストレーター
    "illust": "",
    // カード種類
    "cardType": ["ルリグ"],
    // ルリグタイプ/クラス
    "lrigTypeClass": ["タマ"],
    // 色（白,青,緑,赤,黒）
    "color": ["白","黒"],
    // レベル（0-4）
    // レベルの無いカードはnull（ピース/アーツ/スペル/サーバント）
    "level": 4,
    // コスト
    // ルリグ/アシストはグロウコスト、アーツ/ピース/スペルはコスト、シグニ/サーバントは空欄
    "cost": {
      "白": 1,
      "黒": 1
    },
    // パワー（整数）
    // パワーの無いカードはnull
    "power": 13000,
    // 使用タイミング（メインフェイズ/アタックフェイズ/null）
    // 使用タイミングの無いカードはnull
    "timing": ["メインフェイズ"],
    // ライフバースト（true,false,null）
    // ライフバーストの有無のないカードはnull（ルリグ/アシストルリグ/ピース/アーツ）
    // trueの場合はライフバーストの効果をtextのLBキーに記載
    "lifeBurst": "true",
    // カードテキスト
    "text": {
      "好": "カードテキスト",
      "LB": "ライフバーストの効果"
    },
    // フレーバーテキスト
    "flavorText": "",
    // F&Q
    "faq": {
      "F1": "Q1",
      "F2": "Q2"
    },
    // タグ
    "tags": ["スペル", "アーツ"],
    // 追加情報
    "additionalInfo": {
      "繭の部屋": "2枚制限",
      "関連カード": "WXXX-XXX-XXX"
    }
  },
  /* その他のルール */
  // 全角の記号、数字、スペースは半角にする(半角が存在しない【】《》はそのまま)
  /*
  --------------------------------------------- */
  /* 実例1*/
  /*
  ・生データ
WXDi-P12-010

残黒の巫女　タマヨリヒメ＜ザンコクノミコタマヨリヒメ＞
LR

Illust コウサク

カード種類
    ルリグ
カードタイプ
    タマ
色
    黒
レベル
    3
グロウコスト
    《黒》×２
コスト
    -
リミット
    6
パワー
    -
チーム
    -
コイン
    -
フォーマット
    《キーアイコン》《ディーヴァアイコン》
ストーリー

【常】：あなたの、場とエナゾーンにある《ディソナアイコン》のシグニは追加で黒を得る。
【起】《ターン１回》《黒》《黒》：あなたの場に《ディソナアイコン》のシグニが２体以上ある場合、対戦相手のシグニ１体を対象とし、それをトラッシュに置く。
【起】エクシード４：あなたのトラッシュから《ディソナアイコン》のシグニを３枚まで対象とし、それらを場に出す。
「こんなタマでも、いいの？」

FAQ

エナゾーンにあるシグニが追加で黒を得た場合、《黒》のエナの支払いはできますか？
    はい、可能です。また追加で色を得た場合、元の色は失っていませんので元の色のエナを支払うこともできます。 
エクシード４は、アシストルリグの下にあるカードでも支払えますか？
    はい、センターとアシスト含めてあなたのルリグの下から合計４枚をルリグトラッシュに置くことで支払うことができます。 

  ・json 出力 */
  {
    "cardID": "WXDi-P12-010", // 最初に書いてあるIDそのまま
    "productID": "WXDi-P12", // IDからカード番号を抜いた部分
    "image": "public/assets/cards_img/WXDi-P12/WXDi-P12-010.webp", // 上記2つから。 /商品ID/カードID.webp
    "name": "残黒の巫女 タマヨリヒメ", // カード名そのまま。全角スペースは半角スペースに置換
    "subName": ["ざんこくのみこたまよりひめ"], // <> の中にある読み仮名を平仮名にしたもの。略称は入力しない
    "rarity": "LR", // レアリティ
    "illust": "コウサク", // イラストレーター。"-" (イラストレーター不明) の場合は空欄
    "cardType": ["ルリグ"], // カード種類
    "lrigTypeClass": ["タマ"], // ルリグタイプ・クラス
    "color": ["黒"], // 色
    "level": 3, // レベル
    "cost": {
      "黒": 2
    },
    "power": null, // パワー。"-" (無し) の場合は null
    /* チーム, ストーリーはタグに記入。コイン, フォーマット, 限定条件, ストーリーは無視 */
    "timing": [""], // 使用タイミング
    "lifeBurst": "", // ライブバースト。あったりなかったりするので注意
    "text": { // テキスト
      "常": "あなたの、場とエナゾーンにある《ディソナアイコン》のシグニは追加で黒を得る。",
      "起": "《ターン1回》《黒》《黒》：あなたの場に《ディソナアイコン》のシグニが2体以上ある場合、対戦相手のシグニ1体を対象とし、それをトラッシュに置く。",
      "エクシード": "エクシード4：あなたのトラッシュから《ディソナアイコン》のシグニを3枚まで対象とし、それらを場に出す。"
    },
    "flavorText": "「こんなタマでも、いいの？」", // フレーバーテキスト
    "faq": { // FAQ
      "エナゾーンにあるシグニが追加で黒を得た場合、《黒》のエナの支払いはできますか?": "はい、可能です。また追加で色を得た場合、元の色は失っていませんので元の色のエナを支払うこともできます。",
      "エクシード4は、アシストルリグの下にあるカードでも支払えますか?": "はい、センターとアシスト含めてあなたのルリグの下から合計4枚をルリグトラッシュに置くことで支払うことができます。"
    },
    "tags": ["ディソナアイコン"], // タグ。基本的に記入しない
    "additionalInfo": { // 追加情報。入力しない
      "": ""
    }
  },
  /*
