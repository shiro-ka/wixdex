[
  /* テンプレート */
  {
    "name": "",
    "subName": [
      ""
    ],
    "image": "public/assets/cards_img/",
    "productID": "",
    "cardID": "",
    "cardType": [
      ""
    ],
    "lrigTypeClass": [
      ""
    ],
    "level": 0,
    "color": [
      ""
    ],
    "lifeBurst": "",
    "text": {
      "": ""
    },
    "tags": [
      ""
    ]
  },
  /* 凡例 */
  {
    // カード名
    "name": "凡例の巫女 タマヨリヒメ",
    // 検索用の平仮名ワード
    "subName": [
      // 読み
      "はんれいのみこたまよりひめ",
      // 略称など
      "はんたま",
      "ぼんれいのみこたまよりひめ",
      "ぼんたま"
    ],
    // カード画像
    "image": "public/assets/cards_img/商品ID/カードID.webp",
    // 商品ID
    "productID": "商品ID",
    // カードID
    "cardID": "カードID",
    // レアリティ（C,R,SR,等）
    "rarity": "",
    // カード種類
    "cardType": [
      "ルリグ"
    ],
    // ルリグタイプ/クラス
    "lrigTypeClass": [
      "タマ"
    ],
    // 色（白,青,緑,赤,黒）
    "color": [
      "白"
    ],
    // レベル（0-4）
    // レベルの無いカードはnull（ピース/アーツ/スペル/サーバント）
    "level": 4,
    // コスト
    // ルリグ/アシストはグロウコスト、アーツ/ピース/スペルはコスト
    "cost": {
      "白": 1,
      "黒": 1
    },
    // パワー（整数）
    // パワーの無いカードはnull
    "power": 13000,
    // 使用タイミング（メインフェイズ/アタックフェイズ/null）
    // 使用タイミングの無いカードはnull
    "timing": [
      "メインフェイズ"
    ],
    // ライフバースト（true,false,null）
    // ライフバーストの有無のないカードはnull（ルリグ/アシストルリグ/スペル/ピース/アーツ）
    // trueの場合はライフバーストの効果をtextのLBキーに記載
    "lifeBurst": "true",
    // カードテキスト
    "text": {
      "好": "カードテキスト",
      "LB": "ライフバーストの効果"
    },
    // フレーバーテキスト
    "flavorText": "",
    // イラストレーター
    "illust": "",
    // F&Q
    "faq": {
      "F1": "Q1",
      "F2": "Q2"
    },
    // タグ
    "tags": [
      "スペル",
      "アーツ"
    ],
    // 追加情報
    "additionalInfo": {
      "繭の部屋": "2枚制限",
      "関連カード": "WXXX-XXX-XXX"
    }
  },
  /*
  --------------------------------------------- */
  /* テキストのキー */
  {
    "text": {
      "効果": "スペル、ピース、アーツなどの単発効果",
      "使用条件": "使用時の効果。条件や軽減など",
      "リコレクトN": "「リコレクトN枚以上」の効果"
    }
  },
  /* タグ一覧 */
  {
    "tags": [
      "スペル"
    ]
  },
  /* その他 */
  [
    "header.jsonは、最初に読み込まれるjsonファイル。基本的にデフォルトサーバントのみ。",
    "hidden.jsonは、特定の検索条件のときに読み込まれるカード。柄違いサーバント、ダミーカードなど。"
  ]
]